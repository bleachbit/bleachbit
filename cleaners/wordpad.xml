<cleaner id="wordpad" os="windows">
  <label>WordPad</label>
  <description>Word processor</description>
  <option id="mru">
    <label>Most recently used</label>
    <description>Delete the most recently used list</description>
    <!-- Windows XP and 7 -->
    <action command="winreg" path="HKCU\Software\Microsoft\Windows\CurrentVersion\Applets\Wordpad\Recent File List"/>
  </option>
</cleaner>
