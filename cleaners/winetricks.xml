<cleaner id="winetricks" os="linux">
  <label>winetricks</label>
  <option id="temporary_files">
    <label>Temporary files</label>
    <description>Delete the temporary files</description>
    <action command="delete" search="walk.files" path="~/.wine/drive_c/winetrickstmp/"/>
    <action command="delete" search="walk.files" path="~/.winetrickscache/"/>
  </option>
</cleaner>
