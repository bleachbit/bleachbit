<cleaner id="elinks" os="linux">
  <label>ELinks</label>
  <description>Web browser</description>
  <option id="history">
    <label>History</label>
    <description>Delete the cookies, visited URLs, and search history</description>
    <action command="delete" search="file" path="~/.elinks/cookies"/>
    <action command="delete" search="file" path="~/.elinks/globhist"/>
    <action command="delete" search="file" path="~/.elinks/gotohist"/>
    <action command="delete" search="file" path="~/.elinks/searchhist"/>
  </option>
</cleaner>
