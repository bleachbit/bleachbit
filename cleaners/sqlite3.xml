<!-- verified with SQLite 3.7.13 on Ubuntu 12.10 -->
<!-- verified with SQLite 3.11.0 on Ubuntu 16.04 -->
<cleaner id="sqlite3" os="unix">
  <label>sqlite3</label>
  <option id="history">
    <label>History</label>
    <description>Delete the command history</description>
    <action command="delete" search="file" path="~/.sqlite_history"/>
  </option>
</cleaner>
