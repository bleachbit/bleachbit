<cleaner id="d4x" os="linux">
  <label>Downloader for X</label>
  <option id="history">
    <label>History</label>
    <description>Delete the usage history</description>
    <action command="delete" search="glob" path="~/.ntrc_2/history*"/>
    <action command="delete" search="file" path="~/.ntrc_2/cookies.txt"/>
  </option>
</cleaner>
