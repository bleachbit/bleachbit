<cleaner id="chatgpt">
  <label>ChatGPT</label>
  <description translators="Label for ChatGPT desktop app">AI assistant</description>
  <running type="exe" os="macos" same_user="true">ChatGPT</running>
  <option id="cache">
    <label>Cache</label>
    <description>Delete the cache</description>
    <action command="delete" search="walk.all" path="~/Library/Caches/com.openai.chat/" os="macos"/>
    <action command="delete" search="walk.all" path="~/Library/Caches/ChatGPTHelper/" os="macos"/>
  </option>
  <option id="session">
    <label>Local conversation cache</label>
    <description>Delete the local copy of conversations, drafts, and custom GPTs</description>
    <warning>Conversations are re-downloaded from your account the next time you open them, which requires an internet connection</warning>
    <action command="delete" search="walk.all" path="~/Library/Application Support/com.openai.chat/conversations-v3-*/" os="macos"/>
    <action command="delete" search="walk.all" path="~/Library/Application Support/com.openai.chat/drafts-v2-*/" os="macos"/>
    <action command="delete" search="walk.all" path="~/Library/Application Support/com.openai.chat/gizmos-*/" os="macos"/>
    <action command="delete" search="walk.all" path="~/Library/Application Support/com.openai.chat/pinned-items-*/" os="macos"/>
  </option>
</cleaner>
