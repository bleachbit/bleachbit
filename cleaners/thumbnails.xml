<cleaner id="thumbnails" os="unix">
  <label translate="true">Thumbnails</label>
  <description>Icons for files on the system</description>
  <option id="cache">
    <label>Cache</label>
    <description>Delete the cache</description>
    <action command="delete" search="walk.files" path="~/.thumbnails/"/>
    <action command="delete" search="walk.files" path="$XDG_CACHE_HOME/thumbnails/"/>
  </option>
</cleaner>
