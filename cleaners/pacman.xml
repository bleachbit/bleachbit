<cleaner id="pacman" os="linux">
  <label>pacman</label>
  <description>Package manager</description>
  <running type="exe" same_user="false">pacman</running>
  <running type="exe" same_user="false">paccache</running>
  <running type="pathname" same_user="false">/var/lib/pacman/db.lck</running>
  <option id="cache">
    <label translate="false">Clean cache</label>
    <description>Delete the cache</description>
    <action command="pacman.cache"/>
  </option>
</cleaner>
