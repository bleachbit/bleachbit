<cleaner id="duckduckgo" os="macos">
  <label>DuckDuckGo</label>
  <description>Web browser</description>
  <running type="exe" os="macos" same_user="true">DuckDuckGo</running>
  <option id="cache">
    <label>Cache</label>
    <description>Delete the cache</description>
    <!--
DuckDuckGo 1.211.1 on macOS 27.0.1, after browsing and closing the application
~/Library/Caches/com.duckduckgo.macos.browser/WebKit/NetworkCache/
~/Library/Caches/com.duckduckgo.macos.browser/WebKit/CacheStorage/
~/Library/Caches/com.duckduckgo.macos.browser/WebKit/AlternativeServices/
The folder HSTS next to them is not deleted: it keeps the sites that must be
opened with HTTPS, which is a security setting and not a cache.
-->
    <action command="delete" search="walk.all" path="~/Library/Caches/com.duckduckgo.macos.browser/WebKit/NetworkCache/"/>
    <action command="delete" search="walk.all" path="~/Library/Caches/com.duckduckgo.macos.browser/WebKit/CacheStorage/"/>
    <action command="delete" search="walk.all" path="~/Library/Caches/com.duckduckgo.macos.browser/WebKit/AlternativeServices/"/>
  </option>
</cleaner>
