<cleaner id="screenlets">
  <label>Screenlets</label>
  <description>Desktop widgets</description>
  <option id="logs">
    <label>Logs</label>
    <description>Delete the logs</description>
    <action search="glob" command="delete" path="$XDG_CONFIG_HOME/Screenlets/*.log"/>
  </option>
</cleaner>
